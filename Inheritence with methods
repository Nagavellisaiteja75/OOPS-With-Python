class Animal:
    def move(self):
        return "Moving forward..."

    def speak(self):
        return "Generic animal sound"

class Dog(Animal):
    def speak(self):
        return "Bark!"

    def fetch(self):
        return "Fetching the ball"

my_dog = Dog()

print(my_dog.move())
print(my_dog.speak())
print(my_dog.fetch())
